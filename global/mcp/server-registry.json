{
  "version": "1.0.0",
  "description": "Central MCP server registry for Catalyst",
  "removed_log": {
    "2026-02-17": {
      "reason": "CLI-first audit: vendor CLIs and built-in tools replace these MCPs",
      "removed": [
        "filesystem (replaced by built-in Read/Write/Edit/Glob/Grep)",
        "builder-memory (replaced by Agent Memory 8090 + auto-memory files)",
        "apple-doc-mcp (replaced by Context7 — Apple frameworks indexed at trust 10)",
        "n8n-mcp (replaced by n8n REST API via curl)",
        "github-builder (replaced by gh CLI)",
        "git-mcp (replaced by Context7 + git CLI)",
        "airtable (replaced by REST API via curl/python)",
        "supabase MCP (replaced by supabase CLI — already mandated in CLAUDE.md)",
        "applescript (replaced by osascript via Bash)"
      ]
    }
  },
  "profiles": {
    "macos": {
      "condition": "process.platform === 'darwin'",
      "servers": ["iterm-mcp", "siri-shortcuts", "xcodebuildmcp"]
    },
    "development": {
      "condition": "NODE_ENV !== 'production'",
      "servers": ["playwright"]
    }
  },
  "servers": {
    "iterm-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "iterm-mcp"],
      "scope": "global",
      "category": "platform",
      "profile": "macos",
      "description": "iTerm terminal integration (interactive sessions only)"
    },
    "siri-shortcuts": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-siri-shortcuts"],
      "scope": "global",
      "category": "platform",
      "profile": "macos",
      "description": "Siri Shortcuts automation"
    },
    "xcodebuildmcp": {
      "type": "stdio",
      "command": "node",
      "args": ["${PROJECT_ROOT}/global/xcodebuildmcp/src/web/site/xcodebuildmcp/build/index.js"],
      "env": {
        "XCODEBUILDMCP_DYNAMIC_TOOLS": "true"
      },
      "scope": "global",
      "category": "platform",
      "profile": "macos",
      "description": "Xcode build automation for iOS, macOS, and Swift Package Manager projects"
    },
    "shadcn-ui": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@jpisnice/shadcn-ui-mcp-server"],
      "scope": "project",
      "category": "frontend",
      "description": "Shadcn/UI component library integration"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--browser", "chromium"],
      "env": {
        "PLAYWRIGHT_MCP_BROWSER": "chromium",
        "PLAYWRIGHT_MCP_HEADLESS": "true"
      },
      "scope": "development",
      "category": "testing",
      "profile": "development",
      "description": "Web automation and testing"
    },
    "context7": {
      "type": "stdio",
      "command": "node",
      "args": ["${USER_HOME}/Development/context7/dist/index.js", "--transport", "stdio"],
      "scope": "global",
      "category": "core",
      "description": "Up-to-date library documentation for LLM context (24k+ libraries)"
    },
    "react-spring-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["${USER_HOME}/BuilderOS/global/mcp/react-spring-mcp/dist/index.js"],
      "scope": "project",
      "category": "frontend",
      "description": "React-spring animation library API and documentation"
    }
  },
  "roles": {
    "planner": {
      "allowedServers": [],
      "mode": "read",
      "description": "Project planning and analysis (uses gh CLI for GitHub)"
    },
    "reviewer": {
      "allowedServers": [],
      "mode": "read",
      "description": "Code review and quality assessment (uses gh CLI for GitHub)"
    },
    "system-architect": {
      "allowedServers": ["context7"],
      "mode": "read",
      "description": "System design and architecture"
    },
    "frontend-specialist": {
      "allowedServers": ["shadcn-ui", "react-spring-mcp", "context7"],
      "mode": "read",
      "description": "Frontend development and UI"
    },
    "backend-specialist": {
      "allowedServers": ["context7"],
      "mode": "read",
      "description": "Backend API development (uses supabase CLI for database, gh CLI for GitHub)"
    },
    "executor": {
      "allowedServers": [],
      "mode": "none",
      "description": "Task execution (uses gh CLI for GitHub operations)"
    }
  },
  "scopes": {
    "global": {
      "description": "System-wide MCPs available to all projects",
      "servers": ["iterm-mcp", "siri-shortcuts", "xcodebuildmcp", "context7"]
    },
    "project": {
      "description": "Catalyst project-specific MCPs",
      "servers": ["shadcn-ui", "react-spring-mcp"]
    },
    "development": {
      "description": "Development and testing MCPs",
      "servers": ["playwright"]
    },
    "capsule": {
      "description": "Capsule-specific MCPs (defined per capsule)",
      "servers": []
    }
  }
}