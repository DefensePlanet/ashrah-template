{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{{CATALYST_ROOT}}",
        "/tmp"
      ]
    },
    "builder-memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_STORAGE_PATH": "{{CATALYST_ROOT}}/global/claude-config/mcp-data/builder-memory.json"
      }
    },
    "bridge-mcp": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "{{CATALYST_ROOT}}/tools/bridge-mcp/bridge-mcp.js"
      ],
      "env": {
        "CLAUDE_CLI": "claude",
        "CODEX_CLI": "codex"
      }
    },
    "applescript": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-applescript"
      ]
    },
    "siri-shortcuts": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-siri-shortcuts"
      ]
    },
    "apple-doc": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "{{CATALYST_ROOT}}/global/apple-doc-mcp/src/index.js"
      ]
    },
    "xcodebuildmcp": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "{{CATALYST_ROOT}}/global/xcodebuildmcp/src/web/site/xcodebuildmcp/build/index.js"
      ],
      "env": {
        "XCODEBUILDMCP_DYNAMIC_TOOLS": "true"
      }
    },
    "playwright": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "{{HOME_DIR}}/playwright-mcp/cli.js",
        "--browser",
        "chromium"
      ],
      "env": {
        "PLAYWRIGHT_MCP_BROWSER": "chromium",
        "PLAYWRIGHT_MCP_HEADLESS": "true"
      }
    },
    "context7": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "{{HOME_DIR}}/Development/context7/dist/index.js",
        "--transport",
        "stdio"
      ],
      "env": {}
    },
    "airtable": {
      "command": "airtable-mcp-server",
      "args": [],
      "env": {
        "AIRTABLE_API_KEY": "${AIRTABLE_API_KEY}"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN=${GITHUB_TOKEN}",
        "ghcr.io/github/github-mcp-server:latest"
      ]
    },
    "cloudflare-browser": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://browser.mcp.cloudflare.com/sse"
      ]
    },
    "cloudflare-radar": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://radar.mcp.cloudflare.com/sse"
      ]
    },
    "agent-memory": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:8080/sse"
      ]
    }
  }
}
