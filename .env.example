# ============================================================================
# Ashrah Template: environment
# ============================================================================
# setup.sh copies this file to .env (chmod 600). Fill a value in only when the
# tool that reads it asks for it; every key is optional except where noted.
# Never commit .env. Prefer the macOS Keychain for long-lived secrets
# (global/lib/secret_provider.py reads Keychain first, then the environment).
# Capsules keep their own .env inside capsules/<name>/.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Needed by tools and hooks that call the API directly. Claude Code itself can
# run on your `claude login` session.
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
ANTHROPIC_PROXY_BASE_URL=
ANTHROPIC_PROXY_AUTH_TOKEN=
CATALYST_ROOT=
NODE_ENV=
ENVIRONMENT=

# --- Other model providers (optional) ----------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
FAL_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=
HUGGINGFACE_TOKEN=
HUGGING_FACE_HUB_TOKEN=
OLLAMA_URL=
OLLAMA_MODEL=
COMPLETION_MODEL=
DEFAULT_COMPLETION_MODEL=
REASONING_MODEL=

# --- Gateway / router (Infinity mode, optional) -------------------------------
ROUTER_API_KEY=
GATEWAY_HOST=
GATEWAY_PORT=

