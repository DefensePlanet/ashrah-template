# Catalyst Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Your Anthropic API key (for Claude Code)
ANTHROPIC_API_KEY=

# =============================================================================
# AI PROVIDERS (fill in as needed)
# =============================================================================

# OpenRouter — multi-model routing
OPENROUTER_API_KEY=

# Google Gemini — image/video generation via nano-banana
GEMINI_API_KEY=

# OpenAI — for Sora video, GPT image gen
OPENAI_API_KEY=

# =============================================================================
# APPLE DEVELOPER (optional — for iOS/macOS provisioning)
# =============================================================================

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# =============================================================================
# SUPABASE (per-capsule — typically in capsule .env, not here)
# =============================================================================

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SOCIAL PLATFORMS (per-capsule — typically in capsule .env)
# =============================================================================

# META_SYSTEM_USER_TOKEN=
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=

# =============================================================================
# INFRASTRUCTURE (optional)
# =============================================================================

# OBS WebSocket password (for OBS CLI)
# OBS_WEBSOCKET_PASSWORD=

# Proton Mail Bridge (for email automation)
# PROTON_EMAIL=
# PROTON_BRIDGE_PASSWORD=

# Telegram Bot Token (for bot integrations)
# TELEGRAM_BOT_TOKEN=
