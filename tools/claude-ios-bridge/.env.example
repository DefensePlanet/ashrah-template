# Claude iOS Bridge Configuration

# Server settings
CLAUDE_BRIDGE_PORT=5200
CLAUDE_BRIDGE_HOST=0.0.0.0

# API key for iOS app authentication (generate your own)
CLAUDE_BRIDGE_API_KEY=your-secure-api-key-here

# Working directory for Claude operations
CLAUDE_WORKING_DIR={{CATALYST_ROOT}}

# Allowed directories for file access (comma-separated)
ALLOWED_PATHS={{CATALYST_ROOT}},{{HOME_DIR}}/Documents,{{HOME_DIR}}/Downloads

# Optional: Path to Claude CLI (auto-detected if not set)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Optional: Path to Claude Code executable for standalone builds
# CLAUDE_CODE_PATH=/path/to/claude-code

# Supabase (optional - for database operations)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-key
