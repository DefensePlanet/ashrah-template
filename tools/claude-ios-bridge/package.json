{
  "name": "claude-ios-bridge",
  "version": "1.0.0",
  "description": "Local bridge service connecting iOS app to Claude Code via Agent SDK",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "hono": "^4.7.10",
    "zod": "^4.2.1"
  }
}
