# Spotify Configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9876/callback
SPOTIFY_SCOPES=playlist-read-private,playlist-modify-private,playlist-modify-public,user-library-read,user-library-modify

# Apple Music Configuration
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXX.p8
APPLE_MUSIC_USER_TOKEN=
APPLE_STOREFRONT=us

# Optional: Cache settings
CACHE_DIR=data/cache
TOKEN_DIR=data/tokens