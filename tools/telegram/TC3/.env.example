# Telegram {{ORCHESTRATOR_NAME}} Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============== REQUIRED - Bot will not start without these ==============

# Telegram Bot Token from @BotFather
# Get it by creating a bot at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of Telegram user IDs allowed to use the bot
# Get your user ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=12345678,87654321

# ============== OPTIONAL - Core Features ==============

# Working directory for Claude Code operations
# Default: $HOME (your home directory)
# Recommended: {{CATALYST_ROOT}} (Catalyst root)
CLAUDE_WORKING_DIR={{CATALYST_ROOT}}

# Path to claude CLI binary (auto-detected if in PATH)
# Default: auto-detect from PATH
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# ============== OPTIONAL - Voice Transcription ==============

# OpenAI API key for voice message transcription
# Without this, voice messages will not work
# Get it at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Additional context to improve transcription accuracy
# Useful for proper nouns, technical terms, project names
TRANSCRIPTION_CONTEXT=Catalyst, {{ORCHESTRATOR_NAME}}, BuilderOS, Supabase, n8n

# ============== OPTIONAL - Thinking Modes ==============

# Keywords that trigger extended thinking mode (comma-separated)
THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking mode (comma-separated)
THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ============== OPTIONAL - Logging & Auditing ==============

# Path to audit log file
# Default: /tmp/claude-telegram-audit.log
AUDIT_LOG_PATH=/tmp/claude-telegram-audit.log

# Enable JSON format for audit logs (true/false)
# Default: false
AUDIT_LOG_JSON=false

# ============== OPTIONAL - Rate Limiting ==============

# Enable rate limiting (true/false)
# Default: true
RATE_LIMIT_ENABLED=true

# Maximum requests allowed per time window
# Default: 20
RATE_LIMIT_REQUESTS=20

# Rate limit time window in seconds
# Default: 60 (1 minute)
RATE_LIMIT_WINDOW=60

# ============== OPTIONAL - MCP Servers ==============
# Note: MCP servers are configured in mcp-config.ts
# Some MCPs require environment variables to function

# --- Supabase Toolkit ---
# For database operations, migrations, edge functions
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_ID=abcdefghijklmnop
SUPABASE_DB_PASSWORD=your-db-password

# --- Context7 ---
# For up-to-date library documentation
CONTEXT7_API_KEY=your-context7-key

# --- n8n MCP ---
# For workflow automation
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your-n8n-api-key

# --- OBS Studio MCP ---
# For streaming/recording control
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=your-obs-password

# --- Apple Documentation MCP ---
# For Apple framework docs (SwiftUI, UIKit, etc.)
APPLE_DOCS_PATH={{HOME_DIR}}/.apple-docs

# --- Builder Memory ---
# Agent memory system (usually runs locally on port 8090)
# No credentials needed if running locally

# --- Git MCP ---
# For Git operations and repository management
# No credentials needed

# --- Playwright MCP ---
# For browser automation
# No credentials needed

# --- Filesystem MCP ---
# File system access
# No credentials needed

# --- AppleScript MCP ---
# macOS automation
# No credentials needed

# --- Siri Shortcuts MCP ---
# Siri Shortcuts integration
# No credentials needed

# --- shadcn/ui MCP ---
# shadcn/ui component library
# No credentials needed

# --- react-spring MCP ---
# React animation library docs
# No credentials needed

# --- Xcode Build MCP ---
# Xcode project management
# No credentials needed

# --- iTerm MCP ---
# iTerm terminal control
# No credentials needed

# ============== NOTES ==============

# 1. Security: Never commit the .env file to git!
#    It's already in .gitignore.

# 2. File permissions: Set .env to 600 (owner read/write only)
#    chmod 600 .env

# 3. Required vs Optional:
#    - Required: Bot will exit on startup if missing
#    - Optional: Bot starts but some features may not work

# 4. MCP servers: Check mcp-config.ts for full MCP server list
#    and their specific requirements.

# 5. Testing: Run `bun run src/index.ts` to test configuration
#    before deploying as LaunchAgent.

# 6. Validation: The bot validates configuration on startup
#    and logs warnings for missing optional variables.
